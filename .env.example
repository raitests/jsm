# Supabase project URL — used by both browser and server (public by design; RLS is the boundary)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key — safe to expose; RLS enforces access control
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — bypasses RLS; server only, never expose to the client
SUPABASE_SECRET_KEY=

# Clerk publishable key — used by the browser to initialise Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key — used server-side to verify sessions and call Clerk APIs
CLERK_SECRET_KEY=

# OpenAI API key — used server-side for chat completions and text embeddings
OPENAI_API_KEY=

# Clerk webhook signing secret — used to verify the signature on incoming Clerk webhook events
CLERK_WEBHOOK_SIGNING_SECRET=

# Arcjet key — used server-side for rate limiting and prompt injection detection on public routes
ARCJET_KEY=

# PostHog project API key — used by both browser and server for analytics
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog instance host URL (e.g. https://app.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=

# Public URL of this app — used for CORS headers, widget config responses, and absolute URLs
NEXT_PUBLIC_APP_URL=

# Public key for the landing page demo widget — read server-side at request time (not NEXT_PUBLIC_ because it is per-environment config)
LANDING_WIDGET_KEY=
